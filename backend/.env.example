PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/online_book_store
JWT_SECRET=your_jwt_secret_here
NODE_ENV=development

# MWallet Gateway Credentials
MWALLET_API_URL=https://api.mwallet.example.com/payment/purchase
